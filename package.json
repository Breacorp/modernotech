{
  "name": "modernotech-ecosystem",
  "private": true,
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:landing": "turbo run build --filter=landing-main",
    "dev": "turbo run dev",
    "dev:landing": "turbo run dev --filter=landing-main",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\""
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "turbo": "latest"
  },
  "dependencies": {
    "framer-motion": "^12.38.0"
  },
  "optionalDependencies": {
    "@next/swc-darwin-arm64": "^16.2.12"
  }
}
